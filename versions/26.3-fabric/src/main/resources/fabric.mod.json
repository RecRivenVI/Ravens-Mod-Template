    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "${mod_authors}"
    ],
    "license": "${mod_license}",
    "environment": "${fabric_environment}",
    "entrypoints": {
        "main": [
            "${mod_group}.RavensModTemplate"
        ]
    },
    "depends": {
        "fabricloader": ">=${loader_version}",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    }
}
